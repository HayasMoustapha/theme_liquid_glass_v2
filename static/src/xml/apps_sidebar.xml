<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//header" position="after">
            <div t-if="enterpriseLauncherState.isOpen and !env.isSmall and !isScopedApp"
                 class="o_enterprise_app_launcher"
                 t-on-click.self="closeEnterpriseLauncher">
                <div class="o_enterprise_app_launcher_grid" role="menu" aria-label="Applications">
                    <t t-foreach="menuService.getApps()" t-as="app" t-key="app.id">
                        <a t-att-href="getMenuItemHref(app)"
                           t-att-data-menu-xmlid="app.xmlid"
                           t-att-data-section="app.id"
                           role="menuitem"
                           t-att-class="{ 'o_app': true, 'o_enterprise_app_launcher_item': true, focus: menuService.getCurrentApp() === app }"
                           t-on-click.prevent="() => { this.onNavBarDropdownItemSelection(app); this.closeEnterpriseLauncher(); }">
                            <span class="o_enterprise_app_launcher_icon">
                                <t t-if="app.webIconData">
                                    <img t-attf-src="{{app.webIconData}}"
                                         class="o_app_icon"
                                         alt=""/>
                                </t>
                                <t t-if="!app.webIconData and app.webIcon">
                                    <t t-set="webIconParts" t-value="app.webIcon.split(',')"/>
                                    <span class="o_app_icon o_enterprise_app_icon_fallback"
                                          t-att-style="'background-color:' + webIconParts[2]">
                                        <i t-att-class="webIconParts[0]"
                                           t-att-style="'color:' + webIconParts[1]"/>
                                    </span>
                                </t>
                            </span>
                            <span class="o_enterprise_app_launcher_label" t-esc="app.name"/>
                        </a>
                    </t>
                </div>
            </div>
        </xpath>
    </t>

    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o_navbar_apps_menu')]" position="replace">
            <div t-if="!isScopedApp" class="o_navbar_apps_menu">
                <button
                    data-hotkey="h"
                    title="Home Menu"
                    type="button"
                    aria-label="Home Menu"
                    t-att-aria-expanded="enterpriseLauncherState.isOpen ? 'true' : 'false'"
                    t-att-class="{ 'o_enterprise_launcher_toggle': true, show: enterpriseLauncherState.isOpen }"
                    t-on-click="toggleEnterpriseLauncher">
                    <i class="oi oi-apps"/>
                </button>
            </div>
        </xpath>
    </t>

</templates>
