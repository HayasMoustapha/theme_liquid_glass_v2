<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bao_theme_family_override_view_list" model="ir.ui.view">
        <field name="name">bao.theme.family.override.list</field>
        <field name="model">bao.theme.family.override</field>
        <field name="arch" type="xml">
            <list string="BAO Family Overrides">
                <field name="family_key"/>
                <field name="color_primary"/>
                <field name="color_accent"/>
                <field name="bg_app"/>
                <field name="surface_base"/>
                <field name="text_primary"/>
            </list>
        </field>
    </record>

    <record id="bao_theme_family_override_view_form" model="ir.ui.view">
        <field name="name">bao.theme.family.override.form</field>
        <field name="model">bao.theme.family.override</field>
        <field name="arch" type="xml">
            <form string="BAO Family Override">
                <sheet>
                    <group>
                        <field name="config_id" invisible="1"/>
                        <field name="family_key"/>
                    </group>
                    <group string="Colors">
                        <field name="color_primary"/>
                        <field name="color_primary_dark"/>
                        <field name="color_accent"/>
                        <field name="color_accent_hover"/>
                    </group>
                    <group string="Surfaces">
                        <field name="bg_app"/>
                        <field name="surface_base"/>
                        <field name="surface_muted"/>
                        <field name="surface_subtle"/>
                        <field name="surface_raised"/>
                        <field name="border_default"/>
                    </group>
                    <group string="Text">
                        <field name="text_primary"/>
                        <field name="text_secondary"/>
                        <field name="text_muted"/>
                    </group>
                    <footer>
                        <button name="action_reset_family" type="object" string="Reset Family" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bao_theme_family_overrides" model="ir.actions.act_window">
        <field name="name">BAO Family Overrides</field>
        <field name="res_model">bao.theme.family.override</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('config_id', '=', ref('theme_liquid_glass_v2.bao_theme_config_default'))]"/>
        <field name="context" eval="{'default_config_id': ref('theme_liquid_glass_v2.bao_theme_config_default')}"/>
    </record>

    <record id="bao_theme_component_override_view_list" model="ir.ui.view">
        <field name="name">bao.theme.component.override.list</field>
        <field name="model">bao.theme.component.override</field>
        <field name="arch" type="xml">
            <list string="BAO Component Overrides">
                <field name="component_key"/>
                <field name="family_key"/>
                <field name="color_primary"/>
                <field name="color_accent"/>
                <field name="surface_base"/>
                <field name="text_primary"/>
            </list>
        </field>
    </record>

    <record id="bao_theme_component_override_view_form" model="ir.ui.view">
        <field name="name">bao.theme.component.override.form</field>
        <field name="model">bao.theme.component.override</field>
        <field name="arch" type="xml">
            <form string="BAO Component Override">
                <sheet>
                    <group>
                        <field name="config_id" invisible="1"/>
                        <field name="component_key"/>
                        <field name="family_key"/>
                    </group>
                    <group string="Colors">
                        <field name="color_primary"/>
                        <field name="color_primary_dark"/>
                        <field name="color_accent"/>
                        <field name="color_accent_hover"/>
                    </group>
                    <group string="Surfaces">
                        <field name="surface_base"/>
                        <field name="surface_muted"/>
                        <field name="surface_subtle"/>
                        <field name="surface_raised"/>
                        <field name="border_default"/>
                    </group>
                    <group string="Text">
                        <field name="text_primary"/>
                        <field name="text_secondary"/>
                        <field name="text_muted"/>
                    </group>
                    <footer>
                        <button name="action_reset_component" type="object" string="Reset Component" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bao_theme_component_overrides" model="ir.actions.act_window">
        <field name="name">BAO Component Overrides</field>
        <field name="res_model">bao.theme.component.override</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('config_id', '=', ref('theme_liquid_glass_v2.bao_theme_config_default'))]"/>
        <field name="context" eval="{'default_config_id': ref('theme_liquid_glass_v2.bao_theme_config_default')}"/>
    </record>

    <record id="bao_theme_rh01_fixture_view_form" model="ir.ui.view">
        <field name="name">bao.theme.config.rh01.fixture.form</field>
        <field name="model">bao.theme.config</field>
        <field name="arch" type="xml">
            <form string="BAO RH0.1 Fixture Readiness">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="preset_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Global Colors">
                            <group>
                                <field name="color_primary"/>
                                <field name="color_primary_dark"/>
                                <field name="color_primary_soft"/>
                                <field name="color_accent"/>
                                <field name="color_accent_hover"/>
                            </group>
                        </page>
                        <page string="Surfaces">
                            <group>
                                <field name="bg_app"/>
                                <field name="surface_base"/>
                                <field name="surface_muted"/>
                                <field name="surface_subtle"/>
                                <field name="surface_raised"/>
                            </group>
                        </page>
                        <page string="Borders">
                            <group>
                                <field name="border_subtle"/>
                                <field name="border_default"/>
                                <field name="border_selected"/>
                                <field name="border_soft"/>
                                <field name="border_strong"/>
                            </group>
                        </page>
                        <page string="Text">
                            <group>
                                <field name="text_primary"/>
                                <field name="text_heading"/>
                                <field name="text_secondary"/>
                                <field name="text_muted"/>
                                <field name="text_soft"/>
                                <field name="text_disabled"/>
                            </group>
                        </page>
                        <page string="Typography">
                            <group>
                                <field name="font_body"/>
                                <field name="font_display"/>
                            </group>
                        </page>
                        <page string="Radius">
                            <group>
                                <field name="radius_sm"/>
                                <field name="radius_md"/>
                                <field name="radius_lg"/>
                                <field name="radius_xl"/>
                                <field name="radius_pill"/>
                            </group>
                        </page>
                        <page string="Shadows">
                            <group>
                                <field name="shadow_soft"/>
                                <field name="shadow_panel"/>
                                <field name="shadow_popover"/>
                                <field name="shadow_medium"/>
                                <field name="shadow_heavy"/>
                            </group>
                        </page>
                        <page string="Overrides">
                            <group>
                                <field name="family_override_ids" readonly="1"/>
                                <field name="component_override_ids" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bao_theme_rh01_fixture" model="ir.actions.act_window">
        <field name="name">BAO RH0.1 Fixture Readiness</field>
        <field name="res_model">bao.theme.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="bao_theme_rh01_fixture_view_form"/>
        <field name="res_id" eval="ref('theme_liquid_glass_v2.bao_theme_config_default')"/>
        <field name="target">current</field>
        <field name="context">{'form_view_initial_mode': 'view', 'rh01_fixture': True}</field>
    </record>
</odoo>
