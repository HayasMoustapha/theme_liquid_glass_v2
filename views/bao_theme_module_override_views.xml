<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bao_theme_module_override_view_list" model="ir.ui.view">
        <field name="name">bao.theme.module.override.list</field>
        <field name="model">bao.theme.module.override</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="module_id"/>
                <field name="module_name" optional="hide"/>
                <field name="color_primary" placeholder="Inherit"/>
                <field name="color_primary_dark" placeholder="Inherit"/>
                <field name="color_accent" placeholder="Inherit"/>
                <field name="bg_app" placeholder="Inherit"/>
                <field name="surface_base" placeholder="Inherit"/>
                <field name="text_primary" placeholder="Inherit"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="bao_theme_module_override_view_form" model="ir.ui.view">
        <field name="name">bao.theme.module.override.form</field>
        <field name="model">bao.theme.module.override</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Module">
                            <field name="module_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Colors">
                            <field name="color_primary" placeholder="Inherit global"/>
                            <field name="color_primary_dark" placeholder="Inherit global"/>
                            <field name="color_accent" placeholder="Inherit global"/>
                        </group>
                    </group>
                    <group>
                        <group string="Surfaces">
                            <field name="bg_app" placeholder="Inherit global"/>
                            <field name="surface_base" placeholder="Inherit global"/>
                        </group>
                        <group string="Text">
                            <field name="text_primary" placeholder="Inherit global"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
