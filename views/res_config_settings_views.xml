<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bao.theme</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="BAO Backend Theme" string="BAO Backend Theme" name="bao_backend_theme" groups="base.group_system" logo="/theme_liquid_glass_v2/static/description/icon.png">
                    <field name="bao_theme_config_id" invisible="1"/>
                    <block title="Global Theme" name="bao_global_theme">
                        <setting string="Brand Colors" help="Configure the approved global BAO brand colors. Empty fields inherit the default BAO preset.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="bao_color_primary" class="col-lg-4 o_light_label"/>
                                    <field name="bao_color_primary" widget="color" placeholder="#1357a0"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bao_color_primary_dark" class="col-lg-4 o_light_label"/>
                                    <field name="bao_color_primary_dark" widget="color" placeholder="#0f4e92"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bao_color_accent" class="col-lg-4 o_light_label"/>
                                    <field name="bao_color_accent" widget="color" placeholder="#fde900"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Surfaces" help="Configure backend background, panel, and border tokens.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="bao_bg_app" class="col-lg-4 o_light_label"/>
                                    <field name="bao_bg_app" widget="color" placeholder="#f9f9f9"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bao_surface_base" class="col-lg-4 o_light_label"/>
                                    <field name="bao_surface_base" widget="color" placeholder="#ffffff"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bao_surface_raised" class="col-lg-4 o_light_label"/>
                                    <field name="bao_surface_raised" widget="color" placeholder="#e5e5e5"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bao_border_default" class="col-lg-4 o_light_label"/>
                                    <field name="bao_border_default" widget="color" placeholder="#c9c9c9"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Text" help="Configure approved text colors.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="bao_text_primary" class="col-lg-4 o_light_label"/>
                                    <field name="bao_text_primary" widget="color" placeholder="#303030"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bao_text_secondary" class="col-lg-4 o_light_label"/>
                                    <field name="bao_text_secondary" widget="color" placeholder="#3f3f3f"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bao_text_muted" class="col-lg-4 o_light_label"/>
                                    <field name="bao_text_muted" widget="color" placeholder="#8a8a8a"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Typography And Shape" help="Keep typography, radius, and shadow values inside the approved BAO token contract.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="bao_font_body" class="col-lg-4 o_light_label"/>
                                    <field name="bao_font_body" placeholder="&quot;Open Sans&quot;, sans-serif"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bao_font_display" class="col-lg-4 o_light_label"/>
                                    <field name="bao_font_display" placeholder="&quot;CreightonPro&quot;, &quot;Open Sans&quot;, sans-serif"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bao_radius_md" class="col-lg-4 o_light_label"/>
                                    <field name="bao_radius_md" placeholder="16px"/>
                                </div>
                                <div class="row mt8">
                                    <label for="bao_shadow_panel" class="col-lg-4 o_light_label"/>
                                    <field name="bao_shadow_panel" placeholder="0 14px 30px rgba(13, 79, 148, 0.10)"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Status &amp; Semantic Colors" help="BAO status colours, KPI tiles, neutral chips and the title font. Empty fields inherit the BAO defaults.">
                            <div class="content-group">
                                <div class="row mt8"><label for="bao_success_solid" class="col-lg-4 o_light_label"/><field name="bao_success_solid" widget="color" placeholder="#027f3d"/></div>
                                <div class="row mt8"><label for="bao_success_bg" class="col-lg-4 o_light_label"/><field name="bao_success_bg" widget="color" placeholder="#e4f9f0"/></div>
                                <div class="row mt8"><label for="bao_success_text" class="col-lg-4 o_light_label"/><field name="bao_success_text" widget="color" placeholder="#027f3d"/></div>
                                <div class="row mt8"><label for="bao_danger_600" class="col-lg-4 o_light_label"/><field name="bao_danger_600" widget="color" placeholder="#d94f45"/></div>
                                <div class="row mt8"><label for="bao_warning_tile" class="col-lg-4 o_light_label"/><field name="bao_warning_tile" widget="color" placeholder="#fffbcc"/></div>
                                <div class="row mt8"><label for="bao_danger_tile" class="col-lg-4 o_light_label"/><field name="bao_danger_tile" widget="color" placeholder="#fadada"/></div>
                                <div class="row mt8"><label for="bao_success_tile" class="col-lg-4 o_light_label"/><field name="bao_success_tile" widget="color" placeholder="#c0fedd"/></div>
                                <div class="row mt8"><label for="bao_neutral_chip" class="col-lg-4 o_light_label"/><field name="bao_neutral_chip" widget="color" placeholder="#e9e9e9"/></div>
                                <div class="row mt8"><label for="bao_neutral_soft" class="col-lg-4 o_light_label"/><field name="bao_neutral_soft" widget="color" placeholder="#dcdcdc"/></div>
                                <div class="row mt8"><label for="bao_text_muted_strong" class="col-lg-4 o_light_label"/><field name="bao_text_muted_strong" widget="color" placeholder="#9aa3ad"/></div>
                                <div class="row mt8"><label for="bao_help_badge_bg" class="col-lg-4 o_light_label"/><field name="bao_help_badge_bg" widget="color" placeholder="#e7effa"/></div>
                                <div class="row mt8"><label for="bao_notebook_chip_bg" class="col-lg-4 o_light_label"/><field name="bao_notebook_chip_bg" widget="color" placeholder="#f0f0f0"/></div>
                                <div class="row mt8"><label for="bao_font_title" class="col-lg-4 o_light_label"/><field name="bao_font_title" placeholder="&quot;CreightonPro&quot;, sans-serif"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Families" name="bao_family_theme">
                        <setting string="Family Overrides" help="Configure only the approved BAO family token overrides. Empty fields inherit global values.">
                            <button name="action_open_bao_family_overrides" type="object" string="Manage Family Overrides" icon="oi-arrow-right" class="btn-link"/>
                        </setting>
                    </block>
                    <block title="Targeted Components" name="bao_component_theme">
                        <setting string="Component Overrides" help="Configure only the approved BAO component token overrides. Components inherit their family by default.">
                            <button name="action_open_bao_component_overrides" type="object" string="Manage Component Overrides" icon="oi-arrow-right" class="btn-link"/>
                        </setting>
                    </block>
                    <block title="Module-Specific Themes" name="bao_module_themes">
                        <setting string="Module Color Overrides" help="Configure specific colors for individual Odoo modules. Empty fields inherit global theme values. Changes apply per-module when navigating between apps.">
                            <button name="action_open_bao_module_overrides" type="object" string="Manage Module Overrides" icon="oi-arrow-right" class="btn-link"/>
                        </setting>
                    </block>
                    <block title="Preview And Reset" name="bao_preview_reset">
                        <setting string="Computed Tokens" help="Preview the active global token resolution before runtime CSS emission.">
                            <field name="bao_preview_css" nolabel="1" readonly="1"/>
                        </setting>
                        <setting string="Contrast Warnings" help="Warnings are advisory; invalid color syntax is rejected before saving.">
                            <field name="bao_contrast_warnings" nolabel="1" readonly="1"/>
                        </setting>
                        <setting string="Reset To BAO" help="Reset overrides while keeping the protected BAO preset as fallback.">
                            <div class="content-group">
                                <button name="action_reset_bao_theme_global" type="object" string="Reset Global" class="btn-secondary"/>
                                <button name="action_reset_bao_theme_all" type="object" string="Full Reset To BAO" class="btn-primary ms-2"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_bao_theme_settings" model="ir.actions.act_window">
        <field name="name">BAO Backend Theme</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'theme_liquid_glass_v2', 'bin_size': False}</field>
    </record>
</odoo>
